  m_EditorClassIdentifier: Assembly-CSharp::CatGuide
  fenetreDialogueHUD: {fileID: 0}
  texteDialogueHUD: {fileID: 0}
  jouerAuDemarrage: 1
  messagesIntro:
  - "Perle a \xE9t\xE9 prise en otage par les \xC9chos !"
  - "Et puis, ils ont d\xE9truit le chemin vers le Jardin secret !"
  - "Si tu offres 3 gemmes \xE0 la vieille statue, \npeut-\xEAtre qu'elle r\xE9parera
    le chemin ?"
  - "Regarde bien autour de toi, je suis s\xFBre \nqu'il y en a qui tra\xEEnent !"
  vitesseEcriture: 0.03
  dureeLectureAuto: 12.37
  touchePasser: 19
